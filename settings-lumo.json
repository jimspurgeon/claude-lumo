{
  "model": "lumo-max",
  "autoCompactWindow": {{AUTO_COMPACT_WINDOW}},
  "env": {
    "CLAUDE_LUMO": "1",
    "CLAUDE_LUMO_LOCAL": "{{LUMO_LOCAL}}",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "lumo-max",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "lumo-max",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "lumo-lite",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "lumo-lite",
    "ANTHROPIC_SMALL_FAST_MODEL": "lumo-lite",
    "CLAUDE_CODE_SUBAGENT_MODEL": "lumo-lite",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "apiKeyHelper": "{{PYTHON}} {{LUMO_DIR}}/scripts/api-key.py {{STATE_DIR}}",
  "statusLine": {
    "type": "command",
    "command": "{{PYTHON}} {{LUMO_DIR}}/statusline.py --lumo"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/no-attribution.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/session-start-offer.py",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/busy-mark.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/lumo-prompt.py {{STATE_DIR}} 1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/lumo-prompt.py {{STATE_DIR}} 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/lumo-prompt.py {{STATE_DIR}} 3",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/lumo-prompt.py {{STATE_DIR}} 4",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/busy-mark.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/busy-mark.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{LUMO_DIR}}/hooks/busy-mark.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false
}
